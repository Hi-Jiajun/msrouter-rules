# FakeIP 排除名单（FakeIP Filter）
# 格式同 Clash 规则（DOMAIN / DOMAIN-SUFFIX / DOMAIN-KEYWORD）
# 命中域名不应返回 FakeIP（7.0.0.0/8 / 2001:2::/48），需走真实解析。

# ── LAN / mDNS / 特殊用途域名 ────────────────────────────────────
DOMAIN-SUFFIX,lan
DOMAIN-SUFFIX,local
DOMAIN-SUFFIX,home.arpa
DOMAIN-SUFFIX,localhost
DOMAIN-SUFFIX,invalid
DOMAIN-SUFFIX,test
DOMAIN,localhost.ptlogin2.qq.com
DOMAIN,localhost.sec.qq.com

# ── NTP 时间同步 ─────────────────────────────────────────────────
DOMAIN-SUFFIX,pool.ntp.org
DOMAIN-SUFFIX,ntp.org
DOMAIN-SUFFIX,time.apple.com
DOMAIN-SUFFIX,time.windows.com
DOMAIN,time.nist.gov
DOMAIN-SUFFIX,ntp.aliyun.com
DOMAIN-SUFFIX,ntp.tencent.com
DOMAIN-SUFFIX,ntp.ntsc.ac.cn
DOMAIN-SUFFIX,cn.ntp.org.cn

# ── Apple APNs 推送持久长连接（消除 Wi-Fi/蜂窝切换 FakeIP 残留）────
DOMAIN-SUFFIX,push.apple.com

# ── 国内与系统原生 Captive Portal 探测 ───────────────────────────
DOMAIN-SUFFIX,msftconnecttest.com
DOMAIN-SUFFIX,msftncsi.com
DOMAIN-SUFFIX,captive.apple.com
DOMAIN-SUFFIX,connectivitycheck.platform.hicloud.com
DOMAIN-SUFFIX,connect.rom.miui.com

# ── 国内 STUN & Steam 下载 CDN ───────────────────────────────────
DOMAIN-SUFFIX,stun.qq.com
DOMAIN-SUFFIX,stun.miwifi.com
DOMAIN-SUFFIX,stun.chat.bilibili.com
DOMAIN-SUFFIX,steamcontent.com
DOMAIN-SUFFIX,steamserver.net

# ── 国内 PCDN / 视频边缘节点 ─────────────────────────────────────
DOMAIN-SUFFIX,mcdn.bilivideo.cn
DOMAIN-SUFFIX,szbdyd.com
DOMAIN-SUFFIX,pcdn.xmcdn.com
